---
import type { ImageMetadata } from "astro"
import Zoomable from "./Zoomable.astro"

interface Props {
  photos: { image: ImageMetadata, alt: string }[]
}

const { photos } = Astro.props
const ratios = photos.map(p => p.image.width / p.image.height)
const total = ratios.reduce((a, b) => a + b, 0)
---

<div class:list={["flex flex-col gap-3 sm:flex-row sm:gap-4", total < 1 && "sm:max-w-[60%]"]}>
  {
    photos.map((p, i) => (
      <Zoomable
        image={p.image}
        alt={p.alt}
        widths={[480, 734, 1068, 1600]}
        sizes={`(max-width: 734px) 92vw, ${Math.round((ratios[i] / total) * 980)}px`}
        style={`flex: ${ratios[i]} 1 0%`}
        class="overflow-hidden rounded-[14px]"
      />
    ))
  }
</div>
